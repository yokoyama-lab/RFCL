(n) (n output) (v1 v2 output-copied)
from
  (= 0 output-copied)
do
  rif (!= 0 output-copied)
    v1 ^= 0;
    v2 ^= 1;
    from (= v1 0)
    do
      v1 += v2;
      v1 <=> v2;
      n -= 1;
    loop
    until (= n 0)
  rfi (!= 0 output-copied)
loop
  output ^= v1;
  output-copied ^= 1;
until (!= output-copied 0)
output-copied ^= 1;
